# 后端环境变量样例
# 说明：app/core/config.py 启动时会自动加载 backend/.env（不覆盖已存在的环境变量），
#       因此本地开发只需 `copy .env.example .env` 后填写即可，无需手动 export。
#       真实环境变量优先级高于 .env，CI / 生产仍可用 export 覆盖。
# 注意：.env 已在 .gitignore 中，严禁提交任何密钥。

# 调试模式（生产环境建议设为 false）
ZHIXUAN_DEBUG=true

# 允许跨域的前端地址，多个用英文逗号分隔
ZHIXUAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 数据库（tasks.md 1.4）
# ---------------------------------------------------------------------------
# 本地开发默认 SQLite，零安装即可跑通；切换 PostgreSQL 只需改这一个变量：
#   postgresql+psycopg://zhixuan:密码@localhost:5432/zhixuan
# 结构变更一律通过 alembic 迁移：cd backend && .venv/Scripts/alembic upgrade head
ZHIXUAN_DATABASE_URL=sqlite:///./.runtime/zhixuan.db
#
# 若某个旧库曾开启过自动建表（表已存在但 alembic_version 为空），迁移会报
# "table already exists"。二选一修复：
#   ① 本地无数据（推荐）：删除 backend/.runtime/zhixuan.db 后重跑 upgrade head
#   ② 库里有数据需保留：先标记基线，再升级
#        .venv/Scripts/alembic stamp 0001_users_profiles
#        .venv/Scripts/alembic upgrade head

# 启动时自动建表（默认 false）。
# ⚠️ 保持 false：建表唯一入口是上面的 alembic 迁移。若设为 true，启动会用
#    create_all() 抢先建表且不写 alembic_version，随后跑 alembic 会报
#    "table already exists"。仅在需要"零迁移快速起一个临时库"时才临时打开。
ZHIXUAN_AUTO_CREATE_TABLES=false

# ---------------------------------------------------------------------------
# 认证（tasks.md 3.1、3.2）
# ---------------------------------------------------------------------------
# 令牌签名密钥：生产环境必须替换为随机值，且不少于 32 字节（HS256，RFC 7518 §3.2）
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(48))"
ZHIXUAN_SECRET_KEY=dev-only-secret-key-change-me-in-production
# 访问令牌有效期（分钟），默认 7 天
ZHIXUAN_TOKEN_TTL_MINUTES=10080
# 口令哈希迭代次数（PBKDF2-HMAC-SHA256）
ZHIXUAN_PASSWORD_ITERATIONS=260000
# 登录失败限流：窗口内失败次数上限 / 锁定时长（秒）
ZHIXUAN_LOGIN_MAX_FAILURES=5
ZHIXUAN_LOGIN_LOCK_SECONDS=300

# ---------------------------------------------------------------------------
# 管理端（tasks.md 8.1）
# ---------------------------------------------------------------------------
# 首个管理员的引导值，仅用于手工执行：
#   cd backend && .venv/Scripts/python.exe -m app.services.admin_seed
# 口令留空则脚本拒绝创建（不会落一个空口令管理员）。
# 生产环境务必替换并妥善保管；管理端账号存 admin_user 表，与 C 端 users 分表。
ZHIXUAN_ADMIN_USERNAME=admin
ZHIXUAN_ADMIN_PASSWORD=

# 运行环境标记：dev / production
ZHIXUAN_ENV=dev

# Embedding defaults to offline fake; set backend/model/key only for real vectors
ZHIXUAN_EMBEDDING_BACKEND=fake
ZHIXUAN_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ZHIXUAN_EMBEDDING_DIM=512
ZHIXUAN_EMBEDDING_API_BASE=
ZHIXUAN_EMBEDDING_API_KEY=
ZHIXUAN_EMBEDDING_BATCH_SIZE=32

# RAG QA defaults to offline fake adapters; configure real models only when available
# 启用真实生成的三件套（缺一项即回退 FakeGenerator）：
#   ZHIXUAN_GENERATION_BACKEND=openai-compatible
#   ZHIXUAN_GENERATION_API_BASE=<OpenAI 兼容地址，不带 /chat/completions>
#   ZHIXUAN_GENERATION_API_KEY=<你的 Key>
# ⚠️ 模型名必须与 `{API_BASE}/models` 返回的 id **完全一致**（含连字符，勿写空格），
#    否则报 403 "This token has no access to model ..."。
ZHIXUAN_RERANK_BACKEND=fake
ZHIXUAN_RERANK_MODEL=BAAI/bge-reranker-base
ZHIXUAN_GENERATION_BACKEND=fake
ZHIXUAN_GENERATION_MODEL=qwen-plus
ZHIXUAN_GENERATION_API_BASE=
ZHIXUAN_GENERATION_API_KEY=
ZHIXUAN_GENERATION_TIMEOUT=30
ZHIXUAN_RAG_VECTOR_TOP_K=20
ZHIXUAN_RAG_BM25_TOP_K=20
ZHIXUAN_RAG_RERANK_TOP_K=5
