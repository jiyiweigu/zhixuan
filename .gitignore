# ===== 本项目专属忽略（智选志愿 · 竞赛工作仓）=====

# AI 工具本地配置目录：个人环境产物（技能副本、内部归档、临时输出），非团队资产，不入库
# 说明：团队共用的 OpenSpec 命令入口保留在 .codebuddy/；OpenSpec 产物本身在 openspec/
.workbuddy/
.agents/

# 第三方他人仓库（非团队原创成果，不入库）
zhangxuefeng-skill-main/

# ===== 通用忽略（代码开发阶段生效）=====

# 依赖
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# 环境与密钥（必须忽略）
.env
.env.*
!.env.example
# 后端本地私有配置（含大模型 API Key）：显式点名，防止上述通配规则被误改后漏防
backend/.env
backend/.env.local
# 启动脚本的本机 Python 绝对路径（各人环境不同，不入库）
scripts/local-paths.bat
*.key
*.pem
secrets.json

# 构建产物
dist/
build/
*.egg-info/

# 本地运行产物（SQLite 数据库、上传缓存等）
.runtime/
backend/.runtime/

# 数据大文件（脚本入库，数据走网盘）
data/raw/*
data/**/*.zip
data/**/*.csv
!data/**/.gitkeep
!data/raw/sample_*.csv

# 导入中间层（import_dataset.py 产出，可重跑，不入库）
data/staged/

# 数据本体与考试院官方扫描件（授权/体积原因不入库，本地留档；
# 重建见 data/DOWNLOAD.md 与 data/MANIFEST.sha256）
data/school_major_score/school_major_score_*.json
data/score_segment/score_segment_*.json
data/score_segment/review_*.html
data/schools/*.json
data/samples/raw/

# ★ ③ 特例：院校库 JSON **保留入库**，与上一条「数据本体移出」不同。
#   理由：院校库是 2.1 主产物，且采集/合并脚本（merge_schools、build_school_*、
#   analyze_school_unmatched、build_school_aliases）直接依赖 schools_raw.json /
#   moe_schools.json 等输入，移出后无法离线复跑。
#   ✅ 队长 2026-10-14 复议：**准予入库**（唯一例外见下）。
#   渠道录取分（school_major_score）与一分一段（score_segment）因体积/授权原因，
#   仍按原策略移出（重建见 data/DOWNLOAD.md）。
!data/schools/*.json

# ⛔ 上海软科（ShanghaiRanking）榜单：第三方版权数据，公开仓库再分发有争议，
#    仅本地留档、不入库 —— 队长 2026-10-14 复议指定的唯一例外。
#    下面三条必须留在 !data/schools/*.json **之后**（git 后匹配者胜出）。
#    重建：python data/scripts/fetch_shanghairanking.py
#          python data/scripts/intersect_shanghai_henan.py
data/schools/shanghairanking_2024.json
data/schools/shanghai_top300.json
data/schools/shanghai_top300_inhenan.json

# 采集脚本的原始页面缓存（可复现，不入库）
data/**/.cache/
data/**/.cache_moe/
data/**/.cache_srk/
data/**/.cache_site/

# ③ 诊断产物（只读排查用，可重跑，不入库）
data/**/*_diag.json

# 向量与数据库导出
*.sql.gz
*.dump
data/vector_store/

# 编辑器与系统
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
logs/

