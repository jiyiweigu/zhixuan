# ===== 本项目专属忽略（智选志愿 · 竞赛工作仓）=====

# AI 工具本地配置目录：个人环境产物（技能副本、内部归档、临时输出），非团队资产，不入库
# 说明：团队共用的 OpenSpec 命令入口保留在 .codebuddy/；OpenSpec 产物本身在 openspec/
.workbuddy/
.agents/

# 第三方他人仓库（非团队原创成果，不入库）
zhangxuefeng-skill-main/

# ===== 通用忽略（代码开发阶段生效）=====

# 依赖
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# 环境与密钥（必须忽略）
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# 构建产物
dist/
build/
*.egg-info/

# 本地运行产物（SQLite 数据库、上传缓存等）
.runtime/
backend/.runtime/

# 数据大文件（脚本入库，数据走网盘）
data/raw/*
data/**/*.zip
data/**/*.csv
!data/**/.gitkeep
!data/raw/sample_*.csv

# 采集脚本的原始页面缓存（可复现，不入库）
data/**/.cache/
data/**/.cache_moe/
data/**/.cache_srk/

# 向量与数据库导出
*.sql.gz
*.dump
data/vector_store/

# 编辑器与系统
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
logs/
