# 依赖
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# 环境与密钥（必须忽略）
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# 构建产物
dist/
build/
*.egg-info/

# 数据大文件（脚本入库，数据走网盘）
data/raw/*
data/**/*.zip
data/**/*.csv
!data/**/.gitkeep
!data/raw/sample_*.csv

# 向量与数据库导出
*.sql.gz
*.dump
data/vector_store/

# 编辑器与系统
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
logs/
